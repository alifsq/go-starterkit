# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME=GO-STARTERKIT
APP_ENV=development
APP_PORT=:8080
APP_TIMEOUT=30s
API_KEY= 
APP_BASE_URL=http://localhost:8080
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Keep empty when directly exposed.
TRUSTED_PROXIES=


# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable # disable, require, verify-full (khusus postgres)

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# ==============================================================================
# Mail Config
# ==============================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Go Starterkit <no-reply@domain.my.id>

# ==============================================================================
# GOLANG-MIGRATE CONFIGURATION (Untuk kemudahan otomasi CLI/Makefile)
# ==============================================================================
# Gunakan format URL sesuai DB_DRIVER yang kamu pilih di atas
MIGRATE_DATABASE_URL=mysql://root:passwor@tcp(127.0.0.1:3306)/db
MIGRATE_PATH=migrations

# ==============================================================================
# JWT CONFIG
# ==============================================================================
JWT_SECRET=jwtpassword
JWT_ACCESS_TOKEN_EXP=15m
JWT_REFRESH_TOKEN_EXP=24h

# ==============================================================================
# REDIS CONFIG
# ==============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
