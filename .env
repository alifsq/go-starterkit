# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME=GO-STARTERKIT
APP_ENV=development
APP_PORT=:8080
APP_TIMEOUT=30s
API_KEY=8877cdaf22a4a35e6c39b3c804d783c032b9c9546d48588e676bf1876bbf6de1


# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=alif13579
DB_NAME=go_starter
DB_SSLMODE=disable # disable, require, verify-full (khusus postgres)

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# ==============================================================================
# GOLANG-MIGRATE CONFIGURATION (Untuk kemudahan otomasi CLI/Makefile)
# ==============================================================================
# Gunakan format URL sesuai DB_DRIVER yang kamu pilih di atas
MIGRATE_DATABASE_URL=mysql://root:alif13579@tcp(127.0.0.1:3306)/go_starter
MIGRATE_PATH=migrations

# ==============================================================================
# JWT CONFIG
# ==============================================================================
JWT_SECRET=jwtpassword
JWT_ACCESS_TOKEN_EXP=15m
JWT_REFRESH_TOKEN_EXP=24h